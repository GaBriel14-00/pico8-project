pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- pico-8 wave defense game: part 1

function _init()
 c_spr=40
 c_fr=3
 player={x=64,y=64,dx=0,dy=0,speed=1.2,jump=-3.5,grav=0.2,on_ground=false,flp=false,dash_timer=0,inv=0,buff_timer=0,spr=1}
 bullets={}
 score=0
 g_wave=1 -- tracks the current arena wave (1 to 5)
 health=100
 max_hp=100
 g_keys={space=false,shift=false,r=false}
 clouds={}
 for i=1,5 do
  add(clouds,{x=rnd(128),y=rnd(40),s=1+rnd(2),speed=0.1+rnd(0.2)})
 end
 cam_x=0
 cam_y=0
 p_msg_t=0
 p_msg_txt=""
 spawners={}
 crystals={}
 loot_drops={}
 r_timer=0
 enemies={}
 game_over=false
 game_win=false
 spawned_count=0
 m_tick=0 
 fan_play=false 
 
 -- brand new state machine manager to safely track your title state
 in_title_screen=true
 
 setup_arena()
 p_msg_txt="wave 1 starting! (25 enemies)"
 p_msg_t=120
 
 -- triggers your tracker pattern 00 loop right on boot!
 music(0)
end

function setup_arena()
 spawners={}
 crystals={}
 loot_drops={}
 enemies={}
 spawned_count=0
 
 -- scans map for crystal tiles to use as spawning points
 for y=0,63 do 
  for x=0,127 do
   local t=mget(x,y)
   if t!=29 and (t==40 or fget(t,5) or fget(t,3)) then
    add(crystals,{x=x,y=y,base=t})
    add(spawners,{x=x*8,y=y*8})
   end
  end
 end
 
 if count(spawners)==0 then
  add(spawners,{x=120,y=80})
  add(spawners,{x=240,y=80})
 end
end

function respawn_collectibles()
 p_msg_txt="wave clear! collectibles respawned!"
 p_msg_t=150
end

function reset_game()
 player.x=64 player.y=64 player.dx=0 player.dy=0 player.on_ground=false player.inv=0 player.buff_timer=0
 health=100 score=0 g_wave=1 game_over=false game_win=false enemies={} bullets={} loot_drops={} r_timer=0 p_msg_txt="" p_msg_t=0
 fan_play=false
 in_title_screen=true -- drops back out to title layout cleanly on restart
 setup_arena()
 music(0)
end

function _update()
 -- blocks gameplay code execution entirely if title loop is running
 if in_title_screen then
  -- checks if player presses x (button 5) to start the game match
  if btnp(5) then
   in_title_screen=false
   sfx(16, 2, 24, 6) -- satisfying click confirmation entry sound tone
  end
  return
 end

 if game_win or game_over then
  if btnp(5) then reset_game() end
  return
 end
 
 if stat(24) == -1 and not game_win then
  music(0)
 end

 update_player()
 update_bullets()
 update_enemies()
 update_crystals()
 update_spawners()
 check_flowers()
 check_drops()
 update_camera()
 update_clouds()
end

function update_clouds()
 for c in all(clouds) do
  c.x -= c.speed
  if c.x < -15 then c.x += 150 c.y = rnd(128) end
 end
end

function update_crystals()
 local anim_offset = flr(t() * 8) % c_fr
 for c in all(crystals) do mset(c.x, c.y, c.base + anim_offset) end
end

function _draw()
 cls(12)
 
 -- draws title layout exclusively if in title card phase
 if in_title_screen then
  camera()
  rectfill(0, 0, 128, 128, 0) -- clear dark background layer
  
  -- bigger yellow title text drawn using double-size scaling
  rectfill(0, 40, 128, 56, 0)
  cursor(10, 42)
  -- custom escape codes to make pico-8 print massive text
  print("\142\143light defender", 10)
  
  -- compact, small [x] icon layout prompt
  local pc=(flr(t()*4)%2==0) and 7 or 5
  print("press [x] to start", 28, 80, pc)
  return
 end

 camera()
 for c in all(clouds) do
  circfill(c.x, c.y, c.s*3, 7)
  circfill(c.x-c.s*2, c.y+1, c.s*2, 7)
  circfill(c.x+c.s*2, c.y+1, c.s*2, 7)
 end
 camera(cam_x, cam_y)
 
 map(0, 0, 0, 0, 128, 64) 
 
 for d in all(loot_drops) do
  circfill(d.x+4, d.y+4, 3, 3) circfill(d.x+4, d.y+4, 2, 11)
 end
 
 local active_boss = nil
 for e in all(enemies) do
  if e.hit_t > 0 then for i=1,15 do pal(i,7) end end
  if e.is_boss then
   active_boss = e
   circfill(e.x+8, e.y+8, 10, 0)
   local boss_color = (e.skill_t > 90) and 9 or 8
   circfill(e.x+8, e.y+8, 8, boss_color)
   spr(213, e.x, e.y, 2, 2)
  else
   circfill(e.x+4, e.y+4, 5, 0)
   circfill(e.x+4, e.y+4, 4, 8)
   spr(17, e.x, e.y)
  end
  if e.hit_t > 0 then pal() end
 end
 
 if not game_over and player.inv % 4 < 2 then
  spr(player.spr, player.x, player.y, 1, 1, player.flp)
 end
 for b in all(bullets) do circfill(b.x, b.y, 2, b.c) end
 
 camera()
 rectfill(0,0,128,7,0) rect(1,1,21,5,6)
 local hw=flr((health/max_hp)*19)
 if hw>0 then rectfill(2,2,2+hw,4,8) end
 
 local target_max=25
 if g_wave==2 then target_max=30 
 elseif g_wave==3 then target_max=35 
 elseif g_wave==4 then target_max=40 
 elseif g_wave==5 then target_max=16 end
 
 local left_count = (target_max - spawned_count) + count(enemies)
 if left_count < 0 then left_count = 0 end
 
 print("left:"..left_count, 26, 1, 7)
 print("wave:"..g_wave, 96, 1, 7)
 if player.buff_timer > 0 then
  local tl=flr(player.buff_timer/30)+1 print("buff:"..tl.."s", 68, 1, 10)
 end
 
 if g_wave==5 and active_boss != nil then
  rectfill(24, 118, 104, 124, 0)
  rect(24, 118, 104, 124, 7)
  local bw=flr((active_boss.hp/20)*78)
  if bw>0 then rectfill(25, 119, 25+bw, 123, 8) end
  print("boss", 54, 110, 7)
 end
 
 if p_msg_t and p_msg_t > 0 then
  p_msg_t -= 1 rectfill(4, 108, 124, 124, 0) rect(4, 108, 124, 124, 6) print(p_msg_txt, 8, 114, 7)
 end
 if game_over then
  rectfill(0, 45, 128, 83, 0) rect(0, 45, 128, 83, 8)
  line(60,50,68,58,8) line(61,50,69,58,8) line(68,50,60,58,8) line(69,50,61,58,8)
  local pc=(flr(t()*4)%2==0) and 7 or 6 print("press \151 to restart", 24, 68, pc)
 end
 if game_win then
  rectfill(0, 35, 128, 93, 0) rect(0, 35, 128, 93, 10)
  local wc=(flr(t()*4)%2==0) and 10 or 11 print("you win!", 44, 45, wc)
  print("score: "..score, 38, 57, 7) print("boss defeated!", 34, 67, 6)
  local pc=(flr(t()*4)%2==0) and 7 or 6 print("press \151 to restart", 24, 79, pc)
 end
end
-- pico-8 wave defense game: part 2

function update_player()
 if player.inv > 0 then player.inv -= 1 end
 if player.buff_timer > 0 then player.buff_timer -= 1 end
 local r_down=stat(28,21) local space_down=stat(28,44) local shift_down=stat(28,225)
 
 local bl=btn(0) or stat(28,4) local br=btn(1) or stat(28,7)
 local bj=btn(2) or btnp(2) or (space_down and not g_keys.space)
 local bd=btnp(5) or (shift_down and not g_keys.shift)
 g_keys.space=space_down g_keys.shift=shift_down g_keys.r=r_down
 if bl then
  player.dx=-player.speed player.flp=true
 elseif br then
  player.dx=player.speed player.flp=false
 else
  player.dx*=0.8
 end
 player.dy+=player.grav
 if bj and player.on_ground then player.dy=player.jump player.on_ground=false end
 if bd then player.dash_timer=5 end
 if player.dash_timer>0 then
  player.dash_timer-=1
  if player.flp then player.dx=-3 else player.dx=3 end
 end
 player.x+=player.dx
 if collide_player(player.x,player.y) then
  if player.dx>0 then player.x=flr((player.x+7)/8)*8-8 end
  if player.dx<0 then player.x=flr(player.x/8)*8+8 end
  player.dx=0
 end
 player.y+=player.dy
 if collide_player(player.x,player.y) then
  if player.dy>0 then
   player.y=flr((player.y+7)/8)*8-8 player.on_ground=true player.dy=0
  elseif player.dy<0 then
   player.y=flr(player.y/8)*8+8 player.dy=0
  end
 else
  if not collide_player(player.x,player.y+1) then player.on_ground=false else player.on_ground=true end
 end
 if btnp(4) or (r_down and not g_keys.r) then shoot() end
 animate_player()
 
 if player.inv==0 then
  for e in all(enemies) do
   local hit_range = e.is_boss and 12 or 6
   if abs(player.x-e.x)<hit_range and abs(player.y-e.y)<hit_range then
    health-=20 
    player.inv=45
    sfx(16, 2, 10, 5) 
    if health<=0 then health=0 game_over=true end
    break
   end
  end
 end
end

function animate_player()
 if not player.on_ground then player.spr=5
 else
  if abs(player.dx)>0.1 then
   local rf={1,2,3,2} local idx=flr(time()*10)%#rf+1 player.spr=rf[idx]
  else player.spr=1 end
 end
end

function shoot()
 local dir=player.flp and -1 or 1 local is_buffed=player.buff_timer>0
 add(bullets,{x=player.x+4,y=player.y+4,dx=dir*3,dmg=is_buffed and 2 or 1,c=is_buffed and 10 or 9})
end

function update_bullets()
 for b in all(bullets) do
  b.x+=b.dx local tx,ty=flr(b.x/8),flr(b.y/8) local wt=mget(tx,ty)
  local hit_solid=wt!=29 and fget(wt,0) and not fget(wt,1) and not fget(wt,6)
  local b_destroyed=false
  
  if hit_solid then
   del(bullets,b)
   b_destroyed=true
  end
  
  if not b_destroyed then
   for e in all(enemies) do
    local sz = e.is_boss and 16 or 8
    if b.x>=e.x and b.x<=e.x+sz and b.y>=e.y and b.y<=e.y+sz then
     e.hp-=b.dmg e.hit_t=3 del(bullets,b) b_destroyed=true
     if e.hp<=0 then
      score+=10 
      if rnd(1)<0.5 then add(loot_drops,{x=e.x,y=e.y}) end
      del(enemies,e) 
      
      local target_max=25
      if g_wave==2 then target_max=30 
      elseif g_wave==3 then target_max=35 
      elseif g_wave==4 then target_max=40 
      elseif g_wave==5 then target_max=16 
      end
      
      if spawned_count>=target_max and count(enemies)==0 then
       if g_wave<5 then
        g_wave+=1
        spawned_count=0
        r_timer=0
        respawn_collectibles()
        if g_wave==2 then p_msg_txt="wave 2! (30 enemies)"
        elseif g_wave==3 then p_msg_txt="wave 3! (35 enemies)"
        elseif g_wave==4 then p_msg_txt="wave 4! (40 enemies)" end
       else
        game_win=true
        if not fan_play then
         fan_play=true
         music(-1)
         sfx(60, 0, 36, 12)
         sfx(61, 0, 40, 12)
         sfx(62, 0, 43, 24)
        end
       end
      end
     end
     break
    end
   end
  end
  
  if not b_destroyed and (b.x<cam_x-16 or b.x>cam_x+144) then del(bullets,b) end
 end
end

function check_flowers()
 local coords={{x=flr(player.x/8),y=flr(player.y/8)},{x=flr((player.x+7)/8),y=flr(player.y/8)},{x=flr(player.x/8),y=flr((player.y+7)/8)},{x=flr((player.x+7)/8),y=flr((player.y+7)/8)}}
 for pt in all(coords) do
  local tile=mget(pt.x,pt.y)
  if tile!=29 then
   if tile==19 or tile==20 or tile==35 or tile==36 or tile==51 or tile==52 then
    local bx,by=pt.x,pt.y
    if (tile==52 or tile==36 or tile==20) then bx-=1 end
    if tile==19 or tile==20 then by+=2 elseif tile==35 or tile==36 then by+=1 end
    mset(bx,by-2,0) mset(bx+1,by-2,0) mset(bx,by-1,0) mset(bx+1,by-1,0) mset(bx,by,0) mset(bx+1,by,0)
    score+=50 player.buff_timer=240 p_msg_txt="collected: blood flower!" p_msg_t=60 break
   end
  end
 end
end

function check_drops()
 for d in all(loot_drops) do
  if player.x+7>=d.x and player.x<=d.x+7 and player.y+7>=d.y and player.y<=d.y+7 then
   del(loot_drops,d) health+=10 if health>max_hp then health=max_hp end
   p_msg_txt="collected: health up!" p_msg_t=45 break
  end
 end
end

function update_spawners()
 r_timer+=1 
 local mw=35 
 local ec=25 
 local spawn_boss = false
 
 if g_wave==2 then mw=35 ec=30
 elseif g_wave==3 then mw=30 ec=35
 elseif g_wave==4 then mw=25 ec=40
 elseif g_wave==5 then 
  mw=40 
  ec=15 
  spawn_boss = true
 end
 
 if r_timer>=mw then
  r_timer=0
  
  if spawned_count<ec and count(spawners)>0 then
   local s=spawners[flr(rnd(count(spawners)))+1]
   local rx=s.x + flr(rnd(13))-6
   local ry=s.y + flr(rnd(13))-6
   add(enemies,{x=rx,y=ry,hp=2,hit_t=0,home_x=rx,home_y=ry,is_boss=false})
   spawned_count+=1
  end
  
  if spawn_boss and spawned_count==ec then
   local s=spawners[flr(rnd(count(spawners)))+1]
   add(enemies,{x=s.x,y=s.y,hp=20,hit_t=0,home_x=s.x,home_y=s.y,is_boss=true,skill_t=0})
   spawned_count+=1 
   p_msg_txt="the boss has awakened!"
   p_msg_t=120
  end
 end
end

function update_camera()
 cam_x=flr(player.x-60) cam_y=flr(player.y-60)
 if cam_x<0 then cam_x=0 end
 if cam_x>896 then cam_x=896 end 
 if cam_y<0 then cam_y=0 end
 if cam_y>384 then cam_y=384 end 
end

function update_enemies()
 for e in all(enemies) do
  if e.hit_t > 0 then e.hit_t -= 1 end
  local dx = player.x - e.x local dy = player.y - e.y local dist = sqrt(dx*dx + dy*dy)
  local ex = e.x local ey = e.y
  
  local spd = 0.5
  
  if e.is_boss then
   spd = 0.8 
   e.skill_t += 1
   if e.skill_t > 120 then
    e.skill_t = 0
    sfx(32, 1, 16, 8)
   elseif e.skill_t > 90 then
    spd = 0.2 
   elseif e.skill_t < 25 then
    spd = 2.2 
   end
  end
  
  if dist > 0 then
   if dist < 160 then ex += (dx/dist) * spd ey += (dy/dist) * spd end
  end
  e.x = ex e.y = ey
 end
end

function collide_player(x, y)
 local tiles={mget(flr(x/8),flr(y/8)),mget(flr((x+7)/8),flr(y/8)),mget(flr(x/8),flr((y+7)/8)),mget(flr((x+7)/8),flr((y+7)/8))}
 for t in all(tiles) do
  if t!=29 and fget(t,0) and not fget(t,1) and not fget(t,6) then return true end
 end
 return false
end

