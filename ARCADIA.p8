pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
 player={
  x=64,y=64,
  w=8,h=8,
  dx=0,dy=0,
  speed=1.2,
  jump=-3.5,
  grav=0.2,
  on_ground=false,
  flp=false,
  dash_timer=0
 }

 bullets={}
 score=0
 level=1
 health=100
 max_health=100
 
 _keys={space=false, shift=false, r=false}
 clouds={}
 for i=1,5 do
  add(clouds, {x=rnd(128), y=rnd(40), s=1+rnd(2), speed=0.1+rnd(0.2)})
 end
end

function _update()
 update_player()
 update_bullets()
 update_clouds()
end

function update_clouds()
 for c in all(clouds) do
  c.x -= c.speed
  if c.x < -15 then c.x = 140 c.y = rnd(40) end
 end
end

function _draw()
 cls(12)

 -- clouds (drawn in screen space, before camera)
 for c in all(clouds) do
  circfill(c.x, c.y, c.s*3, 7)
  circfill(c.x-c.s*2, c.y+1, c.s*2, 7)
  circfill(c.x+c.s*2, c.y+1, c.s*2, 7)
 end

 -- calculate camera
 local cam_x = player.x - 64 + player.w/2
 if cam_x < 0 then cam_x = 0 end
 if cam_x > 1024 - 128 then cam_x = 1024 - 128 end
 camera(cam_x, 0)

 map(0,0,0,0,128,64)

 -- player
 spr(1,player.x,player.y,1,1,player.flp)

 -- bullets
 for b in all(bullets) do
  circfill(b.x,b.y,2,8)
 end
 
 -- reset camera for ui
 camera()
 
 -- ui
 rectfill(1,1,21,5,0)
 rect(1,1,21,5,6)
 local hw=flr((health/max_health)*19)
 if hw>0 then rectfill(2,2,2+hw,4,8) end
 print("score:"..score, 24, 1, 7)
 print("lvl:"..level, 100, 1, 7)
end

-- player logic
function update_player()

 local r_down = stat(28,21)
 local space_down = stat(28,44)
 local shift_down = stat(28,225)
 
 local btn_left = btn(0) or stat(28,4)
 local btn_right = btn(1) or stat(28,7)
 local btn_jump = btnp(2) or (space_down and not _keys.space)
 local btn_dash = btnp(5) or (shift_down and not _keys.shift)
 local btn_shoot = btnp(4) or (r_down and not _keys.r)
 
 _keys.space = space_down
 _keys.shift = shift_down
 _keys.r = r_down

 -- movement
 if btn_left then
  player.dx=-player.speed
  player.flp=true
 elseif btn_right then
  player.dx=player.speed
  player.flp=false
 else
  player.dx*=0.8
 end

 -- jump
 if btn_jump and player.on_ground then
  player.dy=player.jump
 end

 -- gravity
 player.dy+=player.grav

 -- dash
 if btn_dash then
  player.dash_timer=5
 end

 if player.dash_timer>0 then
  player.dash_timer-=1
  if player.flp then
   player.dx=-3
  else
   player.dx=3
  end
 end

 -- move x
 player.x+=player.dx
 if collide_player(player.x,player.y) then
  player.x-=player.dx
  player.dx=0
 end

 -- move y
 player.y+=player.dy
 if collide_player(player.x,player.y) then
  player.y-=player.dy
  player.dy=0
  player.on_ground=true
 else
  player.on_ground=false
 end

 -- shoot
 if btn_shoot then
  shoot()
 end
end

-- bullets
function shoot()
 local dir=player.flp and -1 or 1
 add(bullets,{
  x=player.x+4,
  y=player.y+4,
  dx=dir*3
 })
end

function update_bullets()
 for b in all(bullets) do
  b.x+=b.dx

  if collide(b.x,b.y) then
   del(bullets,b)
  end

  if b.x < player.x - 150 or b.x > player.x + 150 then
   del(bullets,b)
  end
 end
end

-- collision (uses map flag 0)
function collide_player(x,y)
 local left = flr((x+2)/8)
 local right = flr((x+5)/8)
 local top = flr(y/8)
 local bottom = flr((y+7)/8)

 return fget(mget(left,top),0) or fget(mget(right,top),0) or
        fget(mget(left,bottom),0) or fget(mget(right,bottom),0)
end

function collide(x,y)
 local tx=flr(x/8)
 local ty=flr(y/8)
 return fget(mget(tx,ty),0)
end
