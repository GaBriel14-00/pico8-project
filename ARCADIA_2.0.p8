pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
 player={
  x=64,y=64,
  w=8,h=8,
  dx=0,dy=0,
  speed=1.2,
  jump=-3.5,
  grav=0.2,
  on_ground=false,
  flp=false,
  dash_timer=0,
  inv=90,
  buff_ammo=0
 }

 bullets={}
 score=0
 level=1
 health=100
 max_health=100
 
 _keys={space=false, shift=false, r=false}
 clouds={}
 for i=1,5 do
  add(clouds, {x=rnd(128), y=rnd(40), s=1+rnd(2), speed=0.1+rnd(0.2)})
 end
 
 cam_x=0
 cam_y=0
 last_cam_x=0
 last_cam_y=0
 msg_timer=0
 msg_text=""
 
 spawners={}
 rounds=0
 round_timer=0
 enemies={}
 for y=0,63 do
  for x=0,127 do
   if mget(x,y) == 66 then
    add(spawners, {x=x*8, y=y*8})
   end
  end
 end
end

function _update()
 update_player()
 update_bullets()
 update_enemies()
 update_camera()
 update_clouds()
end

function update_clouds()
 for c in all(clouds) do
  c.x -= c.speed
  if c.x < -15 then c.x += 150 c.y = rnd(128) end
 end
end

function _draw()
 cls(12)

 -- clouds (drawn in screen space)
 camera()
 for c in all(clouds) do
  circfill(c.x, c.y, c.s*3, 7)
  circfill(c.x-c.s*2, c.y+1, c.s*2, 7)
  circfill(c.x+c.s*2, c.y+1, c.s*2, 7)
 end

 camera(cam_x, cam_y)

 map(0,0,0,0,128,64)

 -- enemies
 for e in all(enemies) do
  if e.hit_t > 0 then
   for i=1,15 do pal(i,7) end
  end
  circfill(e.x+4, e.y+4, 5, 0)
  circfill(e.x+4, e.y+4, 4, 8)
  spr(17, e.x, e.y)
  if e.hit_t > 0 then pal() end
 end

 -- player
 if player.inv % 4 < 2 then
  spr(1,player.x,player.y,1,1,player.flp)
 end

 -- bullets
 for b in all(bullets) do
  circfill(b.x,b.y,2,b.c)
 end
 
 -- reset camera for ui
 camera()
 
 -- ui
 rectfill(0,0,128,7,0)
 rect(1,1,21,5,6)
 local hw=flr((health/max_health)*19)
 if hw>0 then rectfill(2,2,2+hw,4,8) end
 
 print("score:"..score, 26, 1, 7)
 print("lvl:"..level, 104, 1, 7)
 
 if player.buff_ammo > 0 then
  print("buff:"..player.buff_ammo, 68, 1, 12)
 end
 
 if msg_timer and msg_timer > 0 then
  msg_timer -= 1
  rectfill(4, 108, 124, 124, 0)
  rect(4, 108, 124, 124, 6)
  print(msg_text, 8, 114, 7)
 end
end

-- player logic
function update_player()
 if player.inv > 0 then player.inv -= 1 end

 local r_down = stat(28,21)
 local space_down = stat(28,44)
 local shift_down = stat(28,225)
 
 local btn_left = btn(0) or stat(28,4)
 local btn_right = btn(1) or stat(28,7)
 local btn_jump = btnp(2) or (space_down and not _keys.space)
 local btn_dash = btnp(5) or (shift_down and not _keys.shift)
 local btn_shoot = btnp(4) or (r_down and not _keys.r)
 
 _keys.space = space_down
 _keys.shift = shift_down
 _keys.r = r_down

 -- movement
 if btn_left then
  player.dx=-player.speed
  player.flp=true
 elseif btn_right then
  player.dx=player.speed
  player.flp=false
 else
  player.dx*=0.8
 end

 -- jump
 if btn_jump and player.on_ground then
  player.dy=player.jump
 end

 -- gravity
 player.dy+=player.grav

 -- dash
 if btn_dash then
  player.dash_timer=5
 end

 if player.dash_timer>0 then
  player.dash_timer-=1
  if player.flp then
   player.dx=-3
  else
   player.dx=3
  end
 end

 -- move x
 player.x+=player.dx
 if collide_player(player.x,player.y) then
  player.x-=player.dx
  player.dx=0
 end

 -- move y
 player.y+=player.dy
 if collide_player(player.x,player.y) then
  player.y-=player.dy
  player.dy=0
  player.on_ground=true
 else
  player.on_ground=false
 end
 
 check_collectible(player.x, player.y)

 -- shoot
 if btn_shoot then
  shoot()
 end
end

-- bullets
function shoot()
 local dir=player.flp and -1 or 1
 local is_buffed = player.buff_ammo > 0
 if is_buffed then player.buff_ammo -= 1 end
 add(bullets,{
  x=player.x+4,
  y=player.y+4,
  dx=dir*3,
  dmg=is_buffed and 2 or 1,
  c=9
 })
end

function update_bullets()
 for b in all(bullets) do
  b.x+=b.dx
  local hit = false

  for e in all(enemies) do
   if abs(b.x - e.x - 4) < 6 and abs(b.y - e.y - 4) < 6 then
    e.hp -= b.dmg
    e.hit_t = 5
    hit = true
    if e.hp <= 0 then
     del(enemies, e)
     score += 10
    end
    break
   end
  end

  if hit or collide(b.x,b.y) or b.x < player.x - 150 or b.x > player.x + 150 then
   del(bullets,b)
  end
 end
end

-- collision (uses map flag 0)
function collide_player(x,y)
 local left = flr((x+2)/8)
 local right = flr((x+5)/8)
 local top = flr(y/8)
 local bottom = flr((y+7)/8)

 return fget(mget(left,top),0) or fget(mget(right,top),0) or
        fget(mget(left,bottom),0) or fget(mget(right,bottom),0)
end

function collide(x,y)
 local tx=flr(x/8)
 local ty=flr(y/8)
 return fget(mget(tx,ty),0)
end

function update_camera()
 cam_x = player.x - 64 + player.w/2
 if cam_x < 0 then cam_x = 0 end
 if cam_x > 896 then cam_x = 896 end
 
 cam_y = player.y - 64 + player.h/2
 if cam_y < 0 then cam_y = 0 end
 if cam_y > 384 then cam_y = 384 end
end

function update_enemies()
 if rounds < 5 then
  round_timer += 1
  if round_timer >= 450 then
   round_timer = 0
   rounds += 1
   for s in all(spawners) do
    for i=1,flr(3+rnd(2)) do
     add(enemies, {
      x=s.x + rnd(32) - 16, 
      y=s.y - 16 - rnd(16), 
      hp=2, 
      hit_t=0, 
      home_x=s.x, 
      home_y=s.y
     })
    end
   end
  end
 elseif #enemies == 0 then
  msg_text = "level one clear! you win!"
  msg_timer = 10
 end

 for e in all(enemies) do
  if e.hit_t > 0 then e.hit_t -= 1 end
  
  local dx = player.x - e.x
  local dy = player.y - e.y
  local dist = sqrt(dx*dx + dy*dy)
  
  if dist > 0 then
   if dist < 128 then
    e.x += (dx/dist) * 0.5
    e.y += (dy/dist) * 0.5
   else
    local hx = e.home_x - e.x
    local hy = e.home_y - e.y
    local hdist = sqrt(hx*hx + hy*hy)
    if hdist > 2 then
     e.x += (hx/hdist) * 0.2
     e.y += (hy/hdist) * 0.2
    end
   end
  end
  
  if player.inv <= 0 and dist < 6 then
   health -= 10
   player.inv = 30
   player.dy = -2
   player.dx = player.x < e.x and -3 or 3
  end
 end
end

function check_collectible(x,y)
 local tx,ty = flr((x+4)/8), flr((y+4)/8)
 if fget(mget(tx,ty), 2) then
  for dy=-2,2 do
   for dx=-2,2 do
    if fget(mget(tx+dx, ty+dy), 2) then
     mset(tx+dx, ty+dy, 0)
    end
   end
  end
  player.buff_ammo = 20
  msg_timer = 150
  msg_text = "you found a blood seed golden flower!"
 end
end

